2025-12-25T10:51:52.551237Z  INFO ToolCall: shell_command {"command":"python3 - <<'PY'\nfrom pathlib import Path\nimport re\np=Path('/var/tmp/HN2/misc/ideas_extracted.txt')\ntext=p.read_text(errors='replace')\nsep='__idea__'\nparts=[part.strip('\\n') for part in text.split(sep)]\nparts=[p for p in parts if p.strip()]\n# compute stats: count of empty body, url-only body, lines\nempty_body=0\nurl_only=0\nbodies=[]\nfor part in parts:\n    lines=part.splitlines()\n    body='\\n'.join(lines[1:]).strip()\n    bodies.append(body)\n    if not body:\n        empty_body+=1\n    elif re.fullmatch(r'https?://\\S+', body):\n        url_only+=1\n\nprint('entries',len(parts))\nprint('empty_body',empty_body)\nprint('url_only',url_only)\n# most common title prefixes\nprefixes=['Show HN','Ask HN','Launch HN','Tell HN']\nfor pref in prefixes:\n    cnt=sum(1 for part in parts if part.splitlines()[0].startswith(pref))\n    print(pref,cnt)\n# find max body length\nlens=sorted((len(b) for b in bodies), reverse=True)\nprint('max_body_len',lens[0])\n# sample a longer body entry (first >500)\nfor part,body in zip(parts,bodies):\n    if len(body)>500:\n        title=part.splitlines()[0]\n        print('sample_title',title)\n        print('sample_body_start',body[:300].replace('\\n',' '))\n        break\nPY","workdir":"/var/tmp/HN2"}
2025-12-25T10:52:04.410681Z  INFO ToolCall: shell_command {"command":"python3 - <<'PY'\nfrom pathlib import Path\nimport re\np=Path('/var/tmp/HN2/misc/ideas_extracted.txt')\ntext=p.read_text(errors='replace')\nsep='__idea__'\nparts=[part.strip('\\n') for part in text.split(sep)]\nparts=[p for p in parts if p.strip()]\nbody_has_hn=0\nbody_has_url=0\nbody_has_email=0\nfor part in parts:\n    lines=part.splitlines()\n    body='\\n'.join(lines[1:]).strip()\n    if 'news.ycombinator.com/item?id=' in body:\n        body_has_hn+=1\n    if re.search(r'https?://\\S+', body):\n        body_has_url+=1\n    if re.search(r'@', body):\n        body_has_email+=1\n\nprint('hn_links',body_has_hn)\nprint('url_any',body_has_url)\nprint('email_at',body_has_email)\n# Count subjects with | Hacker News\nhn_title=0\nfor part in parts:\n    title=part.splitlines()[0].strip()\n    if title.endswith('| Hacker News'):\n        hn_title+=1\nprint('title_end_hn',hn_title)\n# unique subjects maybe? but not necessary.\nPY","workdir":"/var/tmp/HN2"}
