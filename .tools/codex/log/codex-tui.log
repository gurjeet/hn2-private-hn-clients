y: grid;\n  gap: 18px;\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n}\n\n.card {\n  background: var(--card);\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  padding: 18px 18px 20px;\n  box-shadow: var(--shadow);\n  opacity: 0;\n  transform: translateY(12px);\n  animation: fade-up 0.6s ease forwards;\n}\n\n.card h3 {\n  margin: 0 0 8px;\n  font-family: var(--font-display);\n  font-size: 1.25rem;\n}\n\n.card p {\n  margin: 0 0 12px;\n  color: var(--muted);\n  font-size: 0.95rem;\n}\n\n.meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.tag {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 4px 10px;\n  border-radius: 999px;\n  background: #f6eee3;\n  color: #704836;\n  font-size: 0.75rem;\n  letter-spacing: 0.02em;\n  text-transform: uppercase;\n}\n\n.card-footer {\n  margin-top: 12px;\n  font-size: 0.85rem;\n  color: var(--muted);\n}\n\n.detail {\n  display: grid;\n  gap: 18px;\n  max-width: 820px;\n}\n\n.detail h1 {\n  margin: 0;\n  font-family: var(--font-display);\n  font-size: clamp(2.2rem, 4vw, 3.4rem);\n}\n\n.detail p {\n  margin: 0;\n  color: var(--muted);\n  font-size: 1.05rem;\n}\n\n.detail-meta {\n  display: grid;\n  gap: 12px;\n  padding: 16px;\n  border-radius: var(--radius);\n  border: 1px solid var(--line);\n  background: #fffdf9;\n}\n\n.detail-meta strong {\n  font-size: 0.85rem;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  color: #7a5a4b;\n}\n\n.detail-links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.detail-links a {\n  padding: 8px 14px;\n  border-radius: 999px;\n  border: 1px solid var(--accent);\n  color: var(--accent);\n  font-size: 0.9rem;\n}\n\n.detail-links a:hover {\n  background: var(--accent);\n  color: #fff;\n}\n\n.site-footer {\n  margin-top: 60px;\n  padding-top: 24px;\n  border-top: 1px solid var(--line);\n  color: var(--muted);\n  font-size: 0.9rem;\n}\n\n@keyframes fade-up {\n  to {\n    opacity: 1;\n    transform: translat